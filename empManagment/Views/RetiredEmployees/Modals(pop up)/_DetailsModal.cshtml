@model clsRetiredEmployee
<div class="modal fade" id="detailsModal-@Model.RetiredEmployeeID" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-person-x-fill me-2"></i>
                    Retired Employee Details
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="row mb-3">
                    <div class="col-5 fw-bold">Employee ID:</div>
                    <div class="col-7">@Model.RetiredEmployeeID</div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 fw-bold">Name:</div>
                    <div class="col-7">
                        @Model.FirstName @Model.LastName
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 fw-bold">Department:</div>
                    <div class="col-7">
                        @Model.Department?.DepName
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 fw-bold">Position:</div>
                    <div class="col-7">
                        @Model.Position?.PosTitle
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 fw-bold">Hire Date:</div>
                    <div class="col-7">
                        @Model.HireDate.ToShortDateString()
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 fw-bold">Retirement Date:</div>
                    <div class="col-7">
                        @Model.RetirementDate.ToShortDateString()
                    </div>
                </div>

                <div class="row">
                    <div class="col-5 fw-bold">Total Service:</div>
                    <div class="col-7">
                        @Model.TotalService
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>