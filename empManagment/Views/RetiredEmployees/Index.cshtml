@model IEnumerable<clsRetiredEmployee>

<div class="contaner mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bolder">Retired Employees List</h2>
        
        
    </div>


    <table class="table table-striped table-bordered text-center align-middle">


        <thead>
            <tr class="table-primary">
                <th scope="col">Name</th>
                <th scope="col">Depatrment</th>
                <th scope="col">Position</th>
                <th scope="col">Hire Date</th>
                <th scope="col">Retirement Date</th>
                <th scope="col">Total Service</th>
                <th scope="col">Details</th>

                
            </tr>
        </thead>

        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.FirstName @emp.LastName</td>
                    <td>@emp.Department?.DepName</td>
                    <td>@emp.Position?.PosTitle</td>
                    <td>@emp.HireDate.ToShortDateString()</td>
                    <td>@emp.RetirementDate.ToShortDateString()</td>
                    <!-- <td>@(emp.RetirementDate.Year - emp.HireDate.Year) </td>-->
                    <td>@emp.TotalService</td>
                    <td>
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#detailsModal-@emp.RetiredEmployeeID">
                            <i class="bi bi-info-circle-fill"></i>
                        </button>
                    </td>
                </tr>
                <partial name="~/Views/RetiredEmployees/Modals(pop up)/_DetailsModal.cshtml" model="emp" />

            }
        </tbody>
    </table>

    <label class="text-primary fw-bolder">#Retired Employees: @ViewBag.TotalRetierdEmployees</label>

    <nav>
        <ul class="pagination justify-content-center">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            }

        </ul>
    </nav>
</div>

