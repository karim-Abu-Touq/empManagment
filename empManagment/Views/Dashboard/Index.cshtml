@model clsDashboardViewModel

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="text-primary fw-bold">Dashboard</h2>
        <p class="text-muted">Employee Management System Overview</p>
    </div>

    <div class="row g-4">

        <!-- Employees -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Employees"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <i class="bi bi-people-fill fs-1 text-primary"></i>

                        <h5 class="card-title mt-3">
                            Total Employees
                        </h5>

                        <h2 class="fw-bold">
                            @Model.TotalEmployees
                        </h2>

                        <small class="text-muted">
                            View Employees →
                        </small>

                    </div>
                </div>

            </a>
        </div>


        <!-- Departments -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Departments"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <i class="bi bi-building-fill fs-1 text-success"></i>

                        <h5 class="card-title mt-3">
                            Total Departments
                        </h5>

                        <h2 class="fw-bold">
                            @Model.TotalDepartments
                        </h2>

                        <small class="text-muted">
                            View Departments →
                        </small>

                    </div>
                </div>

            </a>
        </div>


        <!-- Positions -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Positions"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <i class="bi bi-briefcase-fill fs-1 text-warning"></i>

                        <h5 class="card-title mt-3">
                            Total Positions
                        </h5>

                        <h2 class="fw-bold">
                            @Model.TotalPositions
                        </h2>

                        <small class="text-muted">
                            View Positions →
                        </small>

                    </div>
                </div>

            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="RetiredEmployees"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <i class="bi bi-person-x-fill fs-1 text-danger"></i>

                        <h5 class="card-title mt-3">
                            Retired Employees
                        </h5>

                        <h2 class="fw-bold">
                            @Model.TotalRetiredEmployees
                        </h2>

                        <small class="text-muted">
                            View Retired Employees →
                        </small>

                    </div>
                </div>

            </a>
        </div>

    </div>


   
    <div class="row g-4 mt-1">

        <div class="col-12 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">

                    <i class="bi bi-cash-stack fs-1 text-success"></i>

                    <h5 class="card-title mt-3">
                        Total Salaries
                    </h5>

                    <h2 class="fw-bold">
                        @Model.TotalSalaries.ToString("N2")
                    </h2>

                </div>
            </div>
        </div>


        <div class="col-12 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">

                    <i class="bi bi-bar-chart-fill fs-1 text-info"></i>

                    <h5 class="card-title mt-3">
                        Average Salary
                    </h5>

                    <h2 class="fw-bold">
                        @Model.AverageSalary.ToString("N2")
                    </h2>

                </div>
            </div>
        </div>

    </div>
        <div class="row g-4 mt-4">

            <!-- Employees by Department -->
            <div class="col-12 col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5 class="card-title">
                            Employees by Department
                        </h5>

                        <div style="height: 250px;">
                            <canvas id="employeesDepartmentChart"></canvas>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Salaries by Department -->
            <div class="col-12 col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5 class="card-title">
                            Salaries by Department
                        </h5>

                        <div style="height: 250px;">
                            <canvas id="salaryDepartmentChart"></canvas>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    

</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const departmentNames = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                    Model.EmployeesByDepartment.Keys
                    )
                    );

        const employeeCounts = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                    Model.EmployeesByDepartment.Values
                    )
                    );

        new Chart(
            document.getElementById('employeesDepartmentChart'),
            {
                type: 'bar',

                data: {
                    labels: departmentNames,

                    datasets: [{
                        label: 'Employees',
                        data: employeeCounts,
                        borderWidth: 2,
                        borderRadius: 8,
                        hoverBorderWidth: 3
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    animation: {
                        duration: 1200,
                        easing: 'easeOutQuart'
                    },

                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },

                    plugins: {
                        legend: {
                            display: true
                        },

                        tooltip: {
                            enabled: true,
                            displayColors: false,
                            padding: 12
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,

                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            }
        );
    </script>


    <script>
        const salaryDepartments = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                    Model.SalariesByDepartment.Keys
                    )
                    );

        const salaryValues = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                    Model.SalariesByDepartment.Values
                    )
                    );

        new Chart(
            document.getElementById('salaryDepartmentChart'),
            {
                type: 'bar',

                data: {
                    labels: salaryDepartments,

                    datasets: [{
                        label: 'Total Salaries',
                        data: salaryValues,
                        borderWidth: 2,
                        borderRadius: 8,
                        hoverBorderWidth: 3
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    animation: {
                        duration: 1400,
                        easing: 'easeOutQuart'
                    },

                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },

                    plugins: {
                        legend: {
                            display: true
                        },

                        tooltip: {
                            enabled: true,
                            displayColors: false,
                            padding: 12,

                            callbacks: {
                                label: function(context) {
                                    return ' Salary: ' +
                                        context.raw.toLocaleString();
                                }
                            }
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,

                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            }
        );
    </script>

    <script>

        const salaryDepartments = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                    Model.SalariesByDepartment.Keys
                    )
                    );

        const salaryValues = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                    Model.SalariesByDepartment.Values
                    )
                    );

        new Chart(
            document.getElementById('salaryDepartmentChart'),
            {
                type: 'bar',

                data: {
                    labels: salaryDepartments,

                    datasets: [{
                        label: 'Total Salaries',
                        data: salaryValues,

                        borderWidth: 2,

                        borderRadius: 8,

                        hoverBorderWidth: 3
                    }]
                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    animation: {
                        duration: 1400,
                        easing: 'easeOutQuart'
                    },

                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },

                    plugins: {

                        legend: {
                            display: true
                        },

                        tooltip: {

                            enabled: true,

                            displayColors: false,

                            padding: 12,

                            callbacks: {
                                label: function(context) {

                                    return ' Salary: ' +
                                        context.raw.toLocaleString();
                                }
                            }
                        }
                    },

                    scales: {

                        y: {
                            beginAtZero: true,

                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        }

                    }
                }
            }
        );

    </script>
}