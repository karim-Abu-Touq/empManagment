
@model IEnumerable<clsPosition>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bolder">Positions List</h2>

        <a asp-action="Create"
           asp-controller="Positions"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Position
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <div class="row">

        @foreach (var pos in Model)
        {
            <div class="col-md-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">

                            <h5 class="mb-0 fw-bold">
                                @pos.PosTitle
                            </h5>

                            <span class="badge bg-light text-primary">
                                #@pos.PosID
                            </span>

                        </div>
                    </div>


                    <div class="card-body">

                        <div class="row text-center">

                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">
                                    Department
                                </small>

                                <strong>
                                    @pos.Departments?.DepName
                                </strong>
                            </div>


                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">
                                    Employees
                                </small>

                                <strong>
                                    @pos.PosEmployees.Count()
                                </strong>
                            </div>


                            <div class="col-6">
                                <small class="text-muted d-block">
                                    Minimum Salary
                                </small>

                                <strong>
                                    @pos.MinSalary
                                </strong>
                            </div>


                            <div class="col-6">
                                <small class="text-muted d-block">
                                    Maximum Salary
                                </small>

                                <strong>
                                    @pos.MaxSalary
                                </strong>
                            </div>

                        </div>

                    </div>


                    <div class="card-footer">

                        <div class="d-flex justify-content-between align-items-center">

                            <a asp-action="PosEmployees"
                               asp-route-id="@pos.PosID"
                               class="btn btn-primary btn-sm">

                                <i class="bi bi-people-fill me-1"></i>
                                Show Employees

                            </a>


                            <div class="d-flex gap-2">

                                <button type="button"
                                        class="btn btn-warning btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal-@pos.PosID">

                                    <i class="bi bi-pencil-square"></i>

                                </button>


                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@pos.PosID">

                                    <i class="bi bi-trash3"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <partial name="~/Views/Positions/Modals(pop up)/_UpdateModal.cshtml"
                         model="pos" />

                <partial name="~/Views/Positions/Modals(pop up)/_DeleteModal.cshtml"
                         model="pos" />

            </div>
        }

    </div>


    <div class="mt-3">

        <label class="text-primary fw-bolder">
            #Positions: @ViewBag.TotalPositions
        </label>

    </div>


    <nav class="mt-3">

        <ul class="pagination justify-content-center">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">
                        Previous
                    </a>

                </li>
            }


            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i">
                        @i
                    </a>

                </li>
            }


            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">
                        Next
                    </a>

                </li>
            }

        </ul>

    </nav>

</div>

