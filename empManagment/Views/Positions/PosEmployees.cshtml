@model IEnumerable<clsEmployee>
<div class="container mt-4">
    <div class="card-header">
        <h3 class="text-primary fw-bolder">Department: @ViewBag.Department.DepName </h3>
        <h3 class="text-primary fw-bolder">Position: @ViewBag.Position.PosTitle</h3>
        <h3 class="text-primary fw-bolder">Employees: </h3>
        
    </div>
    <div class="row">

        @foreach (var employee in Model)
        {
            <div class="col-md-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header">
                        <h5 class="mb-0">
                            @employee.FirstName @employee.LastName
                        </h5>
                  
                    </div>

                    <div class="card-body">

                        <div class="row mb-2">
                            <div class="col-6">
                                <strong>Employee ID:</strong>
                                @employee.EmpID
                            </div>

                            <div class="col-6">
                                <strong>Position:</strong>
                                @employee.Position?.PosTitle
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-6">
                                <strong>Salary:</strong>
                                @employee.Salary
                            </div>

                            <div class="col-6">
                                <strong>Phone:</strong>
                                @employee.Phone
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <strong>Email:</strong>
                                @employee.Email
                            </div>

                            <div class="col-6">
                                <strong>Hire Date:</strong>
                                @employee.HireDate.ToShortDateString()
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>