@model IEnumerable<clsDepartment>

<div class="contaner mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bolder">Departments List</h2>
        

        <a asp-action="Create" asp-controller="Departments" class="btn btn-primary">Add Department</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    <div class="row g-4">

        @foreach (var dep in Model)
        {
            <div class="col-12 col-md-6">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0 fw-bolder">
                            <i class="bi bi-building me-2"></i>
                            @dep.DepName
                        </h4>
                    </div>

                    <div class="card-body">

                        <p class="text-muted mb-4">
                            @dep.Description
                        </p>

                        <div class="row text-center g-3 mb-4">

                            <div class="col-6">
                                <div class="border rounded p-3">
                                    <i class="bi bi-briefcase-fill fs-3 text-primary"></i>
                                    <h4 class="fw-bold mb-0">
                                        @dep.DepPositions.Count()
                                    </h4>
                                    <small class="text-muted">
                                        Total Positions
                                    </small>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="border rounded p-3">
                                    <i class="bi bi-people-fill fs-3 text-primary"></i>
                                    <h4 class="fw-bold mb-0">
                                        @dep.DepEmployees.Count()
                                    </h4>
                                    <small class="text-muted">
                                        Total Employees
                                    </small>
                                </div>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between gap-2">

                            <a class="btn btn-primary flex-fill"
                               asp-action="DepPositions"
                               asp-route-id="@dep.DepID">
                                <i class="bi bi-briefcase me-1"></i>
                                Positions
                            </a>

                            <a class="btn btn-dark flex-fill"
                               asp-action="DepEmployees"
                               asp-route-id="@dep.DepID">
                                <i class="bi bi-people me-1"></i>
                                Employees
                            </a>

                        </div>

                    </div>

                    <div class="card-footer bg-transparent">

                        <div class="d-flex justify-content-end gap-2">

                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal-@dep.DepID">
                                <i class="bi bi-pencil-square"></i>
                                Edit
                            </button>

                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal-@dep.DepID">
                                <i class="bi bi-trash3"></i>
                                Delete
                            </button>

                        </div>

                    </div>

                </div>

            </div>

            <partial name="~/Views/Departments/Modals(pop up)/_UpdateModal.cshtml"
                     model="dep" />

            <partial name="~/Views/Departments/Modals(pop up)/_DeleteModal.cshtml"
                     model="dep" />
        }

    </div>

    <label class="text-primary fw-bolder">#Departments: @ViewBag.TotalDepartments</label>

    <nav>
        <ul class="pagination justify-content-center">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            }

        </ul>
    </nav>
</div>

